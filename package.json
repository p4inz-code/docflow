{
  "name": "docflow",
  "version": "1.0.0-rc.1",
  "description": "A professional PDF editing workspace for the modern web",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --prefix apps/renderer dev\" \"wait-on http://localhost:5173 && electron apps/desktop/main.cjs\"",
    "build": "cd apps/renderer && pnpm build",
    "typecheck": "cd apps/renderer && pnpm exec tsc --noEmit --skipLibCheck",
    "lint": "cd apps/renderer && pnpm exec oxlint",
    "test": "cd apps/renderer && pnpm test",
    "test:watch": "cd apps/renderer && pnpm test:watch",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "check": "pnpm verify"
  },
  "keywords": ["pdf", "editor", "annotation", "document", "react", "typescript"],
  "author": "Docflow Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/docflow"
  },
  "bugs": {
    "url": "https://github.com/your-org/docflow/issues"
  },
  "homepage": "https://github.com/your-org/docflow",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {}
}
